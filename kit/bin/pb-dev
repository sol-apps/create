#!/usr/bin/env bash
# pb-dev — local PocketBase workbench for an app repo checkout.
#
#   pb-dev [--port N]        run from an app repo root; serves the app at
#                            http://127.0.0.1:<port> (dashboard at /_/)
#
# This is where schema is edited. Click around the LOCAL dashboard; PocketBase
# (automigrate) writes migration files into ./pb_migrations/ — review, commit,
# push. The deploy delivers them to prod, which applies them. Prod's
# dashboard is read-only by convention: if it's not a committed migration,
# it doesn't happen on prod.
#
# Local state:
#   ./.pb_data        throwaway local DB (gitignored; delete to reset —
#                     migrations rebuild the schema)
#   ./pb_migrations   canonical schema, committed
#   ./pb_hooks        server-side hooks, committed (hot-reloaded here too)
# Superuser: admin@solhann.net, password in pb-secret as "<slug>._local".
set -euo pipefail

# Keep in step with the PocketBase version prod runs — migrations generated by a
# newer local PocketBase may not apply on an older prod.
PB_VERSION="0.39.5"
# Per-platform release pins — prod is linux_amd64, the laptop is darwin_arm64. Both checksums are for the same v0.39.5 upstream release, so a
# binary installed on either platform generates identical migrations.
case "$(uname -s)-$(uname -m)" in
  Linux-x86_64)
    PB_PLAT="linux_amd64"
    PB_SHA256="be407d824bcc41468b99051f356fbba9af7f0efd9b46c168482ae25296e799c7" ;;
  Darwin-arm64)
    PB_PLAT="darwin_arm64"
    PB_SHA256="c28f6a59dc51c1073688f2ec14e386f9e00a62c5c203c37c20376cc0eaff3a10" ;;
  *)
    echo "✗ no pinned pocketbase build for $(uname -s)-$(uname -m)" >&2
    echo "  add the release's sha256 to the case above to support it" >&2
    exit 1 ;;
esac
PB_URL="https://github.com/pocketbase/pocketbase/releases/download/v${PB_VERSION}/pocketbase_${PB_VERSION}_${PB_PLAT}.zip"
PB_BIN="$HOME/.local/bin/pocketbase"
SU_EMAIL="admin@solhann.net"

# GNU coreutils ships sha256sum; macOS ships shasum. Same digest either way.
sha256_verify() {  # <expected-hex> <file>
  local got
  if command -v sha256sum >/dev/null 2>&1; then
    got=$(sha256sum "$2" | cut -d' ' -f1)
  else
    got=$(shasum -a 256 "$2" | cut -d' ' -f1)
  fi
  [ "$got" = "$1" ] || { echo "✗ checksum mismatch for $2 (got $got, want $1)" >&2; exit 1; }
}

PORT=8090
if [ "${1:-}" = "--port" ]; then PORT="${2:?--port needs a number}"; shift 2; fi
[ "$#" -eq 0 ] || { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

SLUG=$(basename "$PWD")
[[ "$SLUG" =~ ^[a-z0-9-]+$ ]] || { echo "✗ run from an app repo root (dir name = slug); got '$SLUG'" >&2; exit 1; }

# pinned binary (same version + checksum discipline as prod)
if ! [ -x "$PB_BIN" ] || ! "$PB_BIN" --version 2>/dev/null | grep -qF "$PB_VERSION"; then
  echo "▸ installing pocketbase $PB_VERSION to $PB_BIN"
  command -v unzip >/dev/null || { echo "✗ need unzip" >&2; exit 1; }
  tmp=$(mktemp -d)
  curl -fsSL -o "$tmp/pb.zip" "$PB_URL"
  sha256_verify "$PB_SHA256" "$tmp/pb.zip"
  unzip -o -q "$tmp/pb.zip" pocketbase -d "$tmp"
  mkdir -p "$(dirname "$PB_BIN")"   # BSD install has no -D
  install -m 755 "$tmp/pocketbase" "$PB_BIN"
  rm -rf "$tmp"
fi

mkdir -p pb_migrations pb_hooks
# keep local DB state out of the repo
if [ -d .git ] && ! grep -qxF '.pb_data/' .gitignore 2>/dev/null; then
  printf '.pb_data/\n' >> .gitignore
  echo "▸ added .pb_data/ to .gitignore"
fi

PASS=$("$(dirname "${BASH_SOURCE[0]}")/pb-secret" new "${SLUG}._local")
# Hooks that behave differently on the workbench (a mock provider, say) read this.
export PB_DEV=1
"$PB_BIN" superuser upsert "$SU_EMAIL" "$PASS" --dir .pb_data >/dev/null

echo "▸ $SLUG local workbench: http://127.0.0.1:$PORT/_/  ($SU_EMAIL / pb-secret get ${SLUG}._local)"
echo "  schema edits land in ./pb_migrations/ — review, commit, push"
exec "$PB_BIN" serve \
  --dir=.pb_data \
  --publicDir=. \
  --hooksDir=pb_hooks \
  --migrationsDir=pb_migrations \
  --http="127.0.0.1:$PORT"
