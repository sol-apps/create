#!/usr/bin/env bash
# push-secrets <slug> — send an app's runtime secrets to prod.
#
#   pb-secret set <slug>.MY_KEY      (value on stdin; keys are ALL-CAPS)
#   push-secrets <slug>
#
# Everything stored as "<slug>.<KEY>" REPLACES the app's runtime environment on prod,
# and its PocketBase restarts; hooks read a value with $os.getenv("MY_KEY"). Nothing is
# ever read back.
#
# It goes over the provisioning key, whose only permitted command on prod is the one
# that takes this. -F /dev/null matters: without it ssh also offers the keys named in
# ~/.ssh/config, prod accepts the ordinary login key first, and the slug is run as a
# shell command instead. The key's passphrase is in macOS Keychain; after a restart the
# agent is empty, and `ssh-add --apple-load-keychain` reloads it with no prompt.
set -euo pipefail

KEY="$HOME/.ssh/pb_provision_ed25519"
PROD="${PB_PROD:-sol@178.104.21.188}"
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

SLUG="${1:-}"
[ "$#" -eq 1 ] && [[ "$SLUG" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] \
  || { sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
[ -f "$KEY" ] || { echo "✗ no provisioning key at $KEY" >&2; exit 1; }

ENV_LINES="$("$BIN_DIR/pb-secret" env "$SLUG")"
if [ -z "$ENV_LINES" ]; then
  echo "✗ no runtime secrets stored for '$SLUG' — add one first:" >&2
  echo "    pb-secret set $SLUG.MY_KEY" >&2
  exit 1
fi
printf '%s\n' "$ENV_LINES" | ssh -F /dev/null -i "$KEY" -o IdentitiesOnly=yes "$PROD" "$SLUG --push-env"
