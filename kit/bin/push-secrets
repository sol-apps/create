#!/usr/bin/env bash
# push-secrets <slug> — send an app's runtime secrets to prod.
#
#   pb-secret set <slug>.MY_KEY      (value on stdin; keys are ALL-CAPS)
#   push-secrets <slug>
#   push-secrets <slug> --clear      remove every runtime secret from the app
#
# Everything stored as "<slug>.<KEY>" REPLACES the app's runtime secrets on prod, and
# its PocketBase restarts; hooks read a value with $os.getenv("MY_KEY"). If the app does
# not come back healthy, prod puts the previous secrets back. Nothing is read back.
#
# On prod this is owner-env (kit/server), which sol may run with sudo and no password,
# and which only acts on an app in /etc/solhann/apps.
set -euo pipefail

PROD="${PB_PROD:-prod}"
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() { sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
SLUG="${1:-}"
[[ "$SLUG" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || usage
case "$#:${2:-}" in
  1:) ;;
  2:--clear) exec ssh "$PROD" "sudo -n /usr/local/bin/owner-env $SLUG --clear" </dev/null ;;
  *) usage ;;
esac

ENV_LINES="$("$BIN_DIR/pb-secret" env "$SLUG")"
if [ -z "$ENV_LINES" ]; then
  echo "✗ no runtime secrets stored for '$SLUG' — add one first:" >&2
  echo "    pb-secret set $SLUG.MY_KEY" >&2
  echo "  (to remove them all on prod: push-secrets $SLUG --clear)" >&2
  exit 1
fi
printf '%s\n' "$ENV_LINES" | ssh "$PROD" "sudo -n /usr/local/bin/owner-env $SLUG"
