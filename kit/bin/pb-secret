#!/usr/bin/env bash
# pb-secret — the laptop's secrets store: what an app's server code needs at run time
# and prod cannot make up for itself (API keys, tokens), plus the local pb-dev
# passwords ("<slug>._local").
#
#   pb-secret get <key>       print the secret (fails if absent)
#   pb-secret new <slug>      generate a random password if absent, then print it
#   pb-secret set <key>       store a value read from stdin
#                             a runtime secret: pb-secret set <slug>.MY_KEY
#   pb-secret rm <key>        delete a stored secret (fails if absent)
#   pb-secret env <slug>      print the app's runtime secrets as KEY=value lines
#                             (what `push-secrets <slug>` sends)
#   pb-secret list            list stored keys (never values)
#
# The dashboard password every app shares is NOT here: it is typed on prod
# (`sudo owner-password`) and never leaves it.
#
# Store: ~/.config/solhann/pb-secrets (dir 700, file 600), lines "key:value".
# Never lands in any repo; scripts read it so you never type passwords.
set -euo pipefail

STORE="${PB_SECRETS_FILE:-$HOME/.config/solhann/pb-secrets}"

usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
[ "$#" -ge 1 ] || usage
CMD="$1"; KEY="${2:-}"

valid_key() { [[ "$1" =~ ^[a-zA-Z0-9._-]+$ ]]; }  # uppercase for "<slug>.<ENV_KEY>" runtime secrets

ensure_store() {
  install -d -m 700 "$(dirname "$STORE")"
  [ -f "$STORE" ] || { touch "$STORE"; chmod 600 "$STORE"; }
}

lookup() { sed -n "s/^$(printf '%s' "$1" | sed 's/[.[\*^$]/\\&/g')://p" "$STORE" | head -1; }

case "$CMD" in
  get)
    [ -n "$KEY" ] || usage
    [ -f "$STORE" ] || { echo "✗ no secrets store at $STORE" >&2; exit 1; }
    v=$(lookup "$KEY")
    [ -n "$v" ] || { echo "✗ no secret for '$KEY'" >&2; exit 1; }
    printf '%s\n' "$v"
    ;;
  new)
    [ -n "$KEY" ] || usage
    valid_key "$KEY" || { echo "✗ bad key '$KEY'" >&2; exit 1; }
    ensure_store
    v=$(lookup "$KEY")
    if [ -z "$v" ]; then
      v=$(openssl rand -base64 30 | tr -dc 'A-Za-z0-9' | head -c 32)
      printf '%s:%s\n' "$KEY" "$v" >> "$STORE"
    fi
    printf '%s\n' "$v"
    ;;
  set)
    [ -n "$KEY" ] || usage
    valid_key "$KEY" || { echo "✗ bad key '$KEY'" >&2; exit 1; }
    ensure_store
    # EOF without a trailing newline is not an error here: `read` still populates
    # $v but returns 1, and under `set -e` that aborted before the store write —
    # so `printf '%s' val | pb-secret set k` silently stored nothing. `|| true`
    # (rather than `|| [ -n "$v" ]`) keeps the empty-input check below reachable.
    IFS= read -r v || true
    [ -n "$v" ] || { echo "✗ empty value" >&2; exit 1; }
    if [ -n "$(lookup "$KEY")" ]; then
      tmp=$(mktemp); grep -v "^$KEY:" "$STORE" > "$tmp" || true
      cat "$tmp" > "$STORE"; rm -f "$tmp"
    fi
    printf '%s:%s\n' "$KEY" "$v" >> "$STORE"
    echo "✓ stored '$KEY'" >&2
    ;;
  rm)
    [ -n "$KEY" ] || usage
    valid_key "$KEY" || { echo "✗ bad key '$KEY'" >&2; exit 1; }
    [ -f "$STORE" ] || { echo "✗ no secrets store at $STORE" >&2; exit 1; }
    [ -n "$(lookup "$KEY")" ] || { echo "✗ no secret for '$KEY'" >&2; exit 1; }
    # Escaped the same way lookup() does: keys contain dots ("<slug>.<KEY>",
    # "_s3.secret"), and an unescaped dot here is a regex wildcard that would take
    # neighbouring entries with it — "mcr-events.INGEST_TOKEN" would also match
    # "mcr-eventsXINGEST_TOKEN". Anchored + trailing ':' so "desk" cannot match
    # "desk._local" or "desk.SOME_KEY".
    esc=$(printf '%s' "$KEY" | sed 's/[.[\*^$]/\\&/g')
    tmp=$(mktemp)
    grep -v "^$esc:" "$STORE" > "$tmp" || true
    # cat-over rather than mv: keeps the store's own 600 perms and inode instead of
    # inheriting mktemp's.
    cat "$tmp" > "$STORE"; rm -f "$tmp"
    echo "✓ removed '$KEY'" >&2
    ;;
  env)
    [ -n "$KEY" ] || usage   # KEY = slug here
    [ -f "$STORE" ] || exit 0
    # "<slug>.<ENV_KEY>:value" -> "ENV_KEY=value" (env keys are ALL-CAPS by
    # convention, which keeps them distinct from superuser entries "<slug>:...")
    sed -n "s/^$(printf '%s' "$KEY" | sed 's/[.[\*^$]/\\&/g')\.\([A-Z][A-Z0-9_]*\):/\1=/p" "$STORE"
    ;;
  list)
    [ -f "$STORE" ] && cut -d: -f1 "$STORE" || true
    ;;
  *) usage ;;
esac
