#!/bin/sh
# owner-lane — the only thing the deploy key may run on prod (the key is the GitHub org
# secret SERVER_SSH_KEY; its line in authorized_keys is):
#
#   command="/usr/local/bin/owner-lane",restrict ssh-ed25519 AAAA...
#
# One key, three verbs, chosen by the first word the client sends:
#
#   rsync --server ... . <slug>/      A site: write-only, symlink-munging rrsync over
#                                     /var/www/apps. Everything that deploys with this
#                                     key publishes its site this way, so this branch
#                                     never changes.
#   pb-rsync --server ... . <slug>/   An app's pb_hooks/ and pb_migrations/ (the deploy
#                                     sends it with rsync --rsync-path=pb-rsync). Handed
#                                     to pb-deploy-jail <slug>, a write-only jail pinned
#                                     to that app, and only for an app in /etc/solhann/apps.
#   provision <slug>                  Make sure the app <slug> has its PocketBase
#                                     (sudo owner-app <slug>). A no-op once it has.
#
# The last two act only on the apps this side of the box owns: the ones recorded in
# /etc/solhann/apps at <slug>.<DOMAIN>. Installed by install.sh in this directory, which
# also has the way back (--rollback).
set -u

deny() { echo "owner-lane: denied: $*" >&2; exit 1; }

[ -n "${SSH_ORIGINAL_COMMAND:-}" ] || deny "no command (interactive use not allowed)"

# Whitespace-split exactly as rrsync does; -f so no token glob-expands.
set -f
# shellcheck disable=SC2086
set -- $SSH_ORIGINAL_COMMAND
set +f

# A slug is one DNS label that fits the pb-<slug> user name (28).
slug_ok() {
  case "$1" in ''|-*|*-|*[!a-z0-9-]*) return 1 ;; esac
  [ "${#1}" -le 28 ]
}

# One of ours: recorded in /etc/solhann/apps (owner-app writes it) at <slug>.<DOMAIN>.
owner_app() {
  d=$(sed -n 's/^DOMAIN=//p' /etc/solhann/conf 2>/dev/null | tail -1)
  [ -n "$d" ] || return 1
  h=$(awk -v s="$1" '$1 == s { print $2; exit }' /etc/solhann/apps 2>/dev/null)
  [ "$h" = "$1.$d" ]
}

case "${1:-}" in
  rsync)
    if [ -x /usr/bin/rrsync ]; then
      exec /usr/bin/rrsync -wo -munge /var/www/apps
    fi
    exec rrsync -wo -munge /var/www/apps
    ;;

  pb-rsync)
    case "$SSH_ORIGINAL_COMMAND" in
      "pb-rsync --server "*) : ;;
      *) deny "malformed pb-rsync command" ;;
    esac
    # Destination: the last word. pb-deploy-jail re-parses the whole command and
    # refuses anything but exactly one destination under this slug.
    for dest; do :; done
    slug=${dest%%/*}
    slug_ok "$slug" || deny "bad destination '$dest'"
    owner_app "$slug" || deny "'$slug' is not one of the solhann apps"
    SSH_ORIGINAL_COMMAND="rsync ${SSH_ORIGINAL_COMMAND#pb-rsync }"
    export SSH_ORIGINAL_COMMAND
    exec /usr/local/bin/pb-deploy-jail "$slug"
    ;;

  provision)
    [ "$#" -eq 2 ] || deny "usage: provision <slug>"
    slug_ok "$2" || deny "bad slug '$2'"
    exec sudo -n /usr/local/bin/owner-app "$2"
    ;;

  *)
    deny "unknown command '${1:-}'"
    ;;
esac
