#!/usr/bin/env bash
# owner-password — the one PocketBase superuser password every app shares. Root.
#
#   ssh -t prod 'sudo owner-password'           choose it (typed twice, never shown) and
#                                               apply it to every app
#   ssh -t prod 'sudo owner-password --apply'   apply the current one again, e.g. after
#                                               restoring an app's data
#
# Then every https://<slug>.<DOMAIN>/_/ takes admin@<DOMAIN> and that password: the apps
# in /etc/solhann/apps that have a PocketBase. It is kept in
# /etc/pocketbase/owner.superuser (root, 0600), with a copy beside each app as
# <slug>.superuser. owner-app gives every new app the same password.
#
# Nothing outside /etc/solhann/apps is touched. It is typed here, on prod, so it never
# passes through a laptop file, a chat or a repository.
set -euo pipefail

PB_BIN=/usr/local/bin/pocketbase
ETC=/etc/pocketbase
LIB=/var/lib/pocketbase
CONF=/etc/solhann/conf
APPS=/etc/solhann/apps
SHARED="$ETC/owner.superuser"

die() { echo "✗ owner-password: $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "run as root"
MODE=set
case "${1:-}" in
  '') ;;
  --apply) MODE=apply ;;
  *) die "usage: owner-password [--apply]" ;;
esac
[ "$#" -le 1 ] || die "usage: owner-password [--apply]"

DOMAIN=$(sed -n 's/^DOMAIN=//p' "$CONF" 2>/dev/null | tail -1)
[ -n "$DOMAIN" ] || die "$CONF names no DOMAIN"
SU_EMAIL="admin@$DOMAIN"

if [ "$MODE" = set ]; then
  [ -t 0 ] || die "type it in a terminal: ssh -t prod 'sudo owner-password'"
  IFS= read -rsp "Password for $SU_EMAIL on every $DOMAIN app: " P1; echo
  IFS= read -rsp "Same again: " P2; echo
  [ "$P1" = "$P2" ] || die "the two did not match; nothing changed"
  [ "${#P1}" -ge 8 ] || die "PocketBase needs at least 8 characters; nothing changed"
  ( umask 077; printf '%s\n' "$P1" > "$SHARED.new" )
  unset P1 P2
  chown root:root "$SHARED.new"
  chmod 600 "$SHARED.new"
  mv -f "$SHARED.new" "$SHARED"
fi
[ -s "$SHARED" ] || die "no shared password yet; run it without --apply"
PASS=$(cat "$SHARED")

ERR=$(mktemp)
trap 'rm -f "$ERR"' EXIT
done_n=0; failed=0
while read -r slug host _; do
  case "$slug" in ''|\#*) continue ;; esac
  [ "$host" = "$slug.$DOMAIN" ] || continue
  [ -f "$ETC/$slug.env" ] || continue                 # a static app: no PocketBase
  id -u "pb-$slug" >/dev/null 2>&1 || continue
  install -m 600 -o root -g root "$SHARED" "$ETC/$slug.superuser"
  if sudo -u "pb-$slug" "$PB_BIN" superuser upsert "$SU_EMAIL" "$PASS" \
       --dir "$LIB/$slug/pb_data" \
       --hooksDir "$LIB/$slug/pb_hooks" \
       --migrationsDir "$LIB/$slug/pb_migrations" >/dev/null 2>"$ERR" </dev/null; then
    echo "  ✓ https://$host/_/"
    done_n=$((done_n + 1))
  else
    echo "  ✗ $slug: $(tail -1 "$ERR")"
    failed=$((failed + 1))
  fi
done < "$APPS"
unset PASS

if [ "$failed" = 0 ]; then
  echo "$done_n app(s) take $SU_EMAIL and the shared password at /_/"
else
  echo "$done_n app(s) done, $failed failed (above); fix and run: sudo owner-password --apply"
  exit 1
fi
